{
  "name": "kora-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:claims": "bun scripts/check-claims.ts",
    "validate:links": "bun scripts/check-links.ts",
    "validate:contrast": "bun scripts/contrast.ts",
    "validate:tokens": "bun scripts/check-tokens.ts",
    "validate:seo": "bun scripts/check-seo.ts",
    "og:image": "bun scripts/generate-og-image.ts",
    "build": "bun run validate:claims && bun run validate:links && bun run validate:contrast && bun run validate:tokens && tsc -b && vite build && bun run validate:seo",
    "preview": "vite preview",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/react-router": "^1.170.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^5",
    "vite": "^8.1.0"
  }
}
